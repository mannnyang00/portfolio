rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /site/portfolio {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "mannnyang00@gmail.com";
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
